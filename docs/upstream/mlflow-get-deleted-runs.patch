+def test_get_deleted_runs_selects_only_run_ids(store: SqlAlchemyStore):
+    run = _run_factory(store)
+    store.delete_run(run.info.run_id)
+
+    statements = []
+
+    def capture_statement(_conn, _cursor, statement, _parameters, _context, _executemany):
+        statements.append(statement.lower())
+
+    sqlalchemy.event.listen(store.engine, "before_cursor_execute", capture_statement)
+    try:
+        deleted_run_ids = store._get_deleted_runs()
+    finally:
+        sqlalchemy.event.remove(store.engine, "before_cursor_execute", capture_statement)
+
+    assert deleted_run_ids == [run.info.run_id]
+    (runs_select,) = [
+        statement
+        for statement in statements
+        if statement.lstrip().startswith("select") and "from runs" in statement
+    ]
+    selected_columns = runs_select.split("from runs")[0]
+    assert "runs.run_uuid" in selected_columns
+    assert "," not in selected_columns
+
+
