+def test_export_loads_the_relationships_it_exports() -> None:
+    class UserExportAdmin(ModelView, model=User):
+        column_list = [User.id, User.addresses]
+        column_export_list = [User.name, User.profile]
+
+    local_app = Starlette()
+    local_admin = Admin(app=local_app, engine=engine)
+    local_admin.add_view(UserExportAdmin)
+
+    def add_users(count: int) -> None:
+        with session_maker() as session:
+            for _ in range(count):
+                session.add(User(name="Daniel", profile=Profile()))
+            session.commit()
+
+    with TestClient(app=local_app, base_url="http://testserver") as client:
+
+        def export_csv() -> None:
+            client.get("/admin/user/export/csv").raise_for_status()
+
+        add_users(1)
+        response = client.get("/admin/user/export/csv")
+        assert response.text == "name,profile\r\nDaniel,Profile 1\r\n"
+        statements = _statements_during(export_csv)
+        # The addresses are shown in the list, but not exported
+        assert not any("FROM addresses" in statement for statement in statements)
+
+        add_users(2)
+        assert len(_statements_during(export_csv)) == len(statements)
+
+
 def test_export_bad_type_is_404(client: TestClient) -> None:
