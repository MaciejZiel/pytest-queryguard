diff --git a/sqladmin/models.py b/sqladmin/models.py
index 10d7ac9..e2107f2 100644
--- a/sqladmin/models.py
+++ b/sqladmin/models.py
@@ -906,6 +906,9 @@ class ModelView(BaseView, metaclass=ModelViewMeta):
         self._form_overrides = self._build_column_pairs(self.form_overrides)
 
         self._export_prop_names = self.get_export_columns()
+        self._export_relation_loads = self._build_relation_loads(
+            self._export_prop_names
+        )
 
         self._import_prop_names = self.get_import_columns()
 
@@ -1201,7 +1204,13 @@ class ModelView(BaseView, metaclass=ModelViewMeta):
         limit = None if limit == 0 else limit
         stmt = self.list_query(request).limit(limit)
 
-        stmt = stmt.options(*self._list_relation_loads)
+        # Load what the export reads, not what the list page shows. A pretty
+        # export also runs the list formatters, which may read the list
+        # page's relationships, so it keeps loading those as well.
+        loads = self._export_relation_loads
+        if self.use_pretty_export:
+            loads = loads + self._list_relation_loads
+        stmt = stmt.options(*loads)
 
         rows = await self._run_query(stmt)
         return rows
