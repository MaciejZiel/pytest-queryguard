         )
 
 
+def test_log_inputs_does_not_read_dataset_schema_or_profile(store: SqlAlchemyStore):
+    experiment_id = _create_experiments(store, "test exp")
+    run = _run_factory(store, config=_get_run_configs(experiment_id))
+    dataset = entities.Dataset(
+        name="name",
+        digest="digest",
+        source_type="st",
+        source="source",
+        schema="schema",
+        profile="profile",
+    )
+    store.log_inputs(run.info.run_id, [entities.DatasetInput(dataset, [])])
+
+    statements = []
+
+    def capture_statement(_conn, _cursor, statement, _parameters, _context, _executemany):
+        statements.append(statement.lower())
+
+    sqlalchemy.event.listen(store.engine, "before_cursor_execute", capture_statement)
+    try:
+        # The dataset exists now, so it is looked up by name and digest
+        store.log_inputs(run.info.run_id, [entities.DatasetInput(dataset, [])])
+    finally:
+        sqlalchemy.event.remove(store.engine, "before_cursor_execute", capture_statement)
+
+    dataset_selects = [
+        statement
+        for statement in statements
+        if statement.lstrip().startswith("select") and "from datasets" in statement
+    ]
+    assert dataset_selects
+    assert not any(
+        "dataset_schema" in statement or "dataset_profile" in statement
+        for statement in dataset_selects
+    )
+
+
